}

QDialogTitleBar {
    background-color: #0f09b0;
    color: #ffffff;  
    font-weight: bold;  
    padding: 8px 12px; 
    border-top-left-radius: 8px;  
    border-top-right-radius: 8px;  
    border-bottom: 1px solid #dddddd;  
    font-size: 16px; 
}

QDialog QPushButton {
    background-color: #0f09b0;  
    color: #ffffff;  
    border: none; 
    border-radius: 5px; 
    padding: 6px 12px; 
    font-size: 14px;  
}

QDialog QPushButton:hover {
    background-color: #3333cc; 
}

QDialog QPushButton:pressed {
    background-color: #0d0870;  
}
